{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuckcard.local/schemas/bundle_manifest.schema.json",
  "title": "Bundle manifest",
  "description": "manifest.json inside a .tuckcard.zip bundle. SPEC.md section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_version",
    "created",
    "platform",
    "deck_id",
    "deck_status",
    "contains_personal_details",
    "overlay",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plugin_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "created": { "type": "string", "format": "date-time" },
    "platform": { "enum": ["claude.ai", "claude-code"] },
    "deck_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "deck_status": {
      "enum": ["intake", "researching", "drafting", "drafted", "reviewed", "rendered"]
    },
    "contains_personal_details": { "type": "boolean" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "rules", "gaps", "themes", "presets"],
      "properties": {
        "findings": { "type": "integer", "minimum": 0 },
        "rules": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "integer", "minimum": 0 },
        "themes": { "type": "integer", "minimum": 0 },
        "presets": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
