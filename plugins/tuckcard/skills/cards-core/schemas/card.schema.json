{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuckcard.local/schemas/card.schema.json",
  "title": "Tuckcard card",
  "description": "One card entry. SPEC.md section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["n", "category", "title", "lines", "basis", "visibility", "approval"],
  "properties": {
    "n": { "type": "integer", "minimum": 1 },
    "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "mark", "note"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "mark": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["target"],
                "properties": {
                  "target": { "type": "string", "minLength": 1 },
                  "occurrence": { "type": "integer", "minimum": 1, "default": 1 },
                  "style": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "note": { "type": ["string", "null"] }
        },
        "if": {
          "properties": { "mark": { "type": "object" } },
          "required": ["mark"]
        },
        "then": {
          "properties": { "note": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^R-[a-z0-9-]+-L?[0-9]{3}$" }
    },
    "visibility": { "enum": ["public", "private"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_hash", "approved_by", "approved_round", "linted_hash"],
      "properties": {
        "approved_hash": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
        "approved_by": { "enum": ["round", "hand-edit"] },
        "approved_round": { "type": ["integer", "null"], "minimum": 0 },
        "linted_hash": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
      }
    }
  }
}
